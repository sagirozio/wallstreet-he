{"p":{"desc":"יצרנית מערכות רובוטיות לניתוחים (da Vinci), שמרוויחה גם ממכירת מכשירים וציוד מתכלה לכל ניתוח.","about":"Intuitive Surgical מייצרת את רובוט הניתוחים da Vinci, המוביל בעולם. מנתחים מפעילים אותו מקונסולה, והוא מאפשר ניתוחים זעיר-פולשניים בחתכים קטנים, בתחומים כמו אורולוגיה, גינקולוגיה וניתוחים כלליים.\nרוב ההכנסות מגיעות לא ממכירת הרובוטים, אלא ממכשירים מתכלים ומשירות שנדרשים בכל ניתוח. היא מוכרת גם את מערכת Ion לביופסיות בריאות."},"f":{"hq":"Sunnyvale, CA, United States","emp":17021,"web":"https://www.intuitive.com","si":2.0,"sr":3.1,"inst":88.6,"sid":"2026-10-30","roe":{"v":17.8,"q":"2026-09-30"}},"e":{"d":"2027-01-21","est":true},"an":{"rec":{"p":"2026-11","now":[13,17,9,1,0],"old":[12,16,11,1,0]},"next":{"d":"2027-01-20","h":"amc","eps":3.01,"rev":3.302,"q":"Q4 2026"},"asOf":"2026-11-18"},"eh":[{"q":"Q3 26","a":3.0,"e":2.7,"ay":-24,"g":1,"ga":1.49,"pa":1.95,"r":3.049,"ry":22,"pr":2.505},{"q":"Q2 26","a":2.8,"e":2.55,"ay":27,"g":1,"ga":2.29,"pa":1.81,"r":2.892,"ry":19,"pr":2.44},{"q":"Q1 26","a":2.5,"e":2.14,"ay":19,"g":1,"ga":2.28,"pa":1.92,"r":2.771,"ry":23,"pr":2.253},{"q":"Q4 25","a":2.53,"e":2.3,"ay":16,"g":1,"ga":2.2,"pa":1.89,"r":2.866,"ry":19,"pr":2.413}],"rp":[{"id":"ISRG-2026-10","t":"ISRG","co":"Intuitive Surgical, Inc.","sector":"בריאות","date":"2026-10-20","q":"Q3 2026","epsAct":3.0,"epsEst":2.64,"epsYoy":25,"epsBasis":"מתואם","revAct":3.0487,"revEst":2.9638,"revYoy":21.7,"guide":"none","guideText":"","note":"","react":"המניה ירדה ב-2.3% במסחר שאחרי הדוח.","ir":"https://www.earningswhispers.com/epsdetails/ISRG","hook":"","auto":true}],"ed":["2026-10-21","2026-07-17","2026-04-22","2026-01-23","2025-10-22","2025-07-23","2025-04-23","2025-01-24"]}